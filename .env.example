# Salin file ini jadi ".env" lalu isi dengan kredensial kamu.
# ".env" TIDAK ikut ke git (.gitignore sudah mengecualikannya).

# --- MongoDB Atlas ---
# Gunakan URI dari cluster Atlas kamu sendiri.
# Contoh: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=...
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0

# Nama database (default: cmms)
MONGO_DB_NAME=cmms

# --- CMMS API ---
# URL endpoint sensor-data di CMMS backend kamu.
CMMS_API_URL=https://cmms-polmanbandung.site/api/ml/sensor-data

# Base URL untuk update status mesin (asset status).
CMMS_API_BASE_URL=https://cmms-polmanbandung.site/api

# JWT token kalau endpoint sudah diproteksi (kosongkan kalau belum).
CMMS_API_TOKEN=
